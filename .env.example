# Base URL includes /v1. The app appends /chat/completions.
# Default: GPT-5.5 via OpenAI. Put your key in .env, never in chat or Git.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5
OPENAI_API_KEY=

# Local example: http://127.0.0.1:11434/v1 plus your installed model's exact ID.
# For another provider use LLM_API_KEY. Unauthenticated local models need no key.
LLM_API_KEY=
# JSON mode may be unsupported by some local servers: set false in that case.
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=120000
# Most local servers accept max_tokens. For OpenAI reasoning models use
# max_completion_tokens. This limit includes reasoning for those models.
LLM_TOKEN_FIELD=max_completion_tokens
LLM_MAX_TOKENS=8192
# Clear this for local models that do not support reasoning_effort.
LLM_REASONING_EFFORT=low
PORT=4317
